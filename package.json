{
  "name": "survey-clean-api",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "repository": "git@github.com:glesiosantos/survey-clean-api.git",
  "author": "Glêsio Santos <glesioss@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "node --no-warnings --loader ts-node/esm src/main/server.ts",
    "lint": "eslint .  . --ext .ts,.tsx --fix",
    "prepare": "husky || true",
    "test": "jest --passWithNoTests --silent --noStackTrace --runInBand",
    "test:verbose": "jest --passWithNoTests",
    "test:unit": "npm test -- -c jest-unit.config.mjs --watch",
    "test:inte": "npm test -- -c jest-inte.config.mjs --watch",
    "test:staged": "npm test --findRelatedTests",
    "test:ci": "npm test -- --coverage",
    "test:clear": "jest --clearCache"
  },
  "devDependencies": {
    "@shelf/jest-mongodb": "^5.2.2",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/mongodb": "^4.0.7",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@types/validator": "^13.15.2",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "eslint": "^9.28.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.4.1",
    "git-commit-msg-linter": "^5.0.8",
    "husky": "^9.1.7",
    "jest": "^30.0.1",
    "lint-staged": "^16.1.0",
    "pinst": "^3.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.1.0",
    "mongodb": "^6.17.0",
    "validator": "^13.15.15"
  }
}
